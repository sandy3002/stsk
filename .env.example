# ==============================================================================
# STSK: Consolidated Next.js Karate Academy Application
# Environment Variables
# ==============================================================================

# MongoDB Connection URI (Atlas M0 Free Tier or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/stsk?retryWrites=true&w=majority

# Session & JWT Secret (Generate with: openssl rand -base64 32)
# Must be at least 32 characters for HS256 encryption in jose
SESSION_SECRET=your-32-character-secret-key-goes-here-replace-in-production

# Initial Admin Credentials (provisioned via `pnpm seed` or auto-seeded on first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisToAStrongPassword123

# Runtime Environment
NODE_ENV=development
