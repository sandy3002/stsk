{
  "name": "stsk",
  "version": "1.0.0",
  "private": true,
  "description": "Student Karate Scoreboard monorepo",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": "pnpm --dir apps/api start:dev",
    "build:web": "pnpm --dir apps/web build",
    "build:api": "pnpm --dir apps/api build",
    "lint:web": "pnpm --dir apps/web lint",
    "lint:api": "pnpm --dir apps/api lint",
    "test": "echo \"No root test suite configured yet\" && exit 0"
  },
  "packageManager": "pnpm@11.23.0",
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@types/passport-jwt": "^4.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mongoose": "^9.10.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "swagger-ui-express": "^5.0.1"
  }
}
